# =============================================================================
# backend/.env — API Nest (Postgres + servidor)
# Preferência local: variáveis separadas.
# Se DATABASE_URL estiver definida, ela tem prioridade sobre host/user/pass.
# =============================================================================

DATABASE_HOST=localhost
DATABASE_PORT=5446
DATABASE_USERNAME=finances
DATABASE_PASSWORD=finances
DATABASE_NAME=finances
# DATABASE_SSL=true
# Host port 5446 evita conflito com connect-3d (5445), giro-auto (5444) e Postgres local (5432)

# Opcional — descomente em deploy se o provedor só entregar URL:
# DATABASE_URL=postgres://finances:finances@localhost:5446/finances

PORT=3002
NODE_ENV=development
CORS_ORIGIN=
